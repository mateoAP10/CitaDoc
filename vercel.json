{
  "rewrites": [
    {
      "source": "/demo/:slug",
      "destination": "/demo.html?slug=:slug"
    },
    {
      "source": "/generar",
      "destination": "/landing.html"
    },
    {
      "source": "/:slug/admin",
      "has": [{ "type": "host", "value": "doctor-center.citadoc.lat" }],
      "destination": "/doctor-center-admin.html"
    },
    {
      "source": "/:slug",
      "has": [{ "type": "host", "value": "doctor-center.citadoc.lat" }],
      "destination": "/doctor-center.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "doctor-center.citadoc.lat" }],
      "destination": "/doctor-center.html"
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "(?!www\\.)((?!citadoc\\.lat$)(?!doctor-center\\.citadoc\\.lat$).+)\\.citadoc\\.lat" }],
      "destination": "/experimental/web-admin-v1.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?!www\\.)((?!citadoc\\.lat$)(?!doctor-center\\.citadoc\\.lat$).+)\\.citadoc\\.lat" }],
      "destination": "/web.html"
    },
    {
      "source": "/:slug/admin",
      "destination": "/experimental/web-admin-v1.html?slug=:slug"
    },
    {
      "source": "/:slug",
      "destination": "/web.html?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
